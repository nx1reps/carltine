# Ingest signing key. Required in any shared environment; without it the app
# generates a dev key next to the local chain file, which will not exist on a
# serverless host and will not survive a restart.
# Generate with: openssl rand -hex 32
CARLTINE_INGEST_SECRET=

# Cloudflare D1. All three are required together; if any is missing the app
# silently falls back to a local file, which is NOT deploy-safe.
# Create the database with:  npx wrangler d1 create carltine
# Then apply db/schema.sql with: npx wrangler d1 execute carltine --file=db/schema.sql
CARLTINE_D1_ACCOUNT_ID=
CARLTINE_D1_DATABASE_ID=
CARLTINE_CF_API_TOKEN=

# Optional: override where the local chain file lives (local dev only).
# CARLTINE_DATA_DIR=
